NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/sawdagar
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_PERSISTENT_EXPIRES_IN=10y
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
UPLOADS_DIR=./uploads

# Account defaults
AUTO_VERIFY_CUSTOMER=false
AUTO_APPROVE_SUPPLIER=false
ADMIN_EMAIL=admin@example.com
ORDER_NOTIFICATION_EMAIL=orders@example.com

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_IGNORE_TLS=false
SMTP_ALLOW_UNAUTH=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sawdagar <no-reply@example.com>
SMTP_FROM_INFO=Sawdagar Info <info@example.com>
SMTP_FROM_SALES=Sawdagar Sales <sales@example.com>
SMTP_FROM_SUPPORT=Sawdagar Support <support@example.com>
SMTP_REPLY_TO=info@example.com
SMTP_REPLY_TO_INFO=info@example.com
SMTP_REPLY_TO_SALES=sales@example.com
SMTP_REPLY_TO_SUPPORT=support@example.com

# Optional product-image processing
PRODUCT_IMAGE_AI_ENABLED=false
PRODUCT_IMAGE_AI_STYLE_STAGE=false
PRODUCT_IMAGE_AI_PYTHON=python3
PRODUCT_IMAGE_AI_MODELS=birefnet-general,isnet-general-use,u2netp
PRODUCT_IMAGE_AI_MIN_LONGEST_SIDE=500
PRODUCT_IMAGE_AI_MIN_AREA=180000
PRODUCT_IMAGE_AI_CANVAS_SIZE=1600
